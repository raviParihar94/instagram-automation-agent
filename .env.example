
# --------------------------------------------------------------------------
# LLM provider (choose ONE and fill its key). All of these have free tiers.
# --------------------------------------------------------------------------
LLM_PROVIDER=groq                 # options: groq | google | openai
GROQ_API_KEY={MY_GROQ_API_KEY}
GROQ_MODEL=llama-3.1-70b-versatile

GOOGLE_API_KEY={GOOGLE_API_KEY}
GOOGLE_MODEL=gemini-1.5-flash

OPENAI_API_KEY={OPENAI_API_KEY}
OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------------------------------
# Free image hosting, needed because Instagram Graph API requires a
# publicly reachable image URL. imgbb has a free API key (https://api.imgbb.com).
# --------------------------------------------------------------------------
IMGBB_API_KEY={IMGBB_API_KEY}

# --------------------------------------------------------------------------
# Instagram Graph API (set via the dashboard too — this is just a fallback)
# --------------------------------------------------------------------------
IG_ACCESS_TOKEN={IG_ACCESS_TOKEN}
IG_USER_ID={IG_USER_ID}



